{
  "name": "@bbplayer/desktop",
  "version": "0.1.3",
  "private": true,
  "description": "BBPlayer Windows desktop player",
  "author": "BBPlayer contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:portable": "node scripts/portable-smoke.mjs",
    "smoke:update": "node scripts/update-smoke.mjs",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --config oxlint.json src electron scripts tests",
    "pack": "pnpm build && electron-builder --win --x64 --dir",
    "dist:win": "pnpm build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.83.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.0",
    "@playwright/test": "^1.58.0"
  },
  "build": {
    "appId": "com.bbplayer.desktop",
    "productName": "BBPlayer",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "build/icon.ico", "package.json"],
    "asar": true,
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "artifactName": "BBPlayer-${version}-${arch}-Setup.${ext}" },
    "portable": { "artifactName": "BBPlayer-${version}-${arch}-Portable.${ext}" }
  }
}
